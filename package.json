{
  "name": "pharmica",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "clean": "turbo clean",
    "railway:api:build": "pnpm --filter @pharmica/database db:generate && pnpm --filter @pharmica/api build",
    "railway:api:predeploy": "pnpm --filter @pharmica/database db:migrate:deploy && pnpm --filter @pharmica/database db:seed",
    "railway:api:start": "pnpm --filter @pharmica/api exec next start"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.71.0"
  },
  "packageManager": "pnpm@10.12.1"
}
